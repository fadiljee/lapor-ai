# ─── App ─────────────────────────────────────────────────────────────────────
PROJECT_NAME=LAPOR-AI
VERSION=1.5

# ─── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=lapor-ai-super-secret-key-ganti-sebelum-produksi
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/lapor_ai
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ─── Redis & Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── LLM Providers ────────────────────────────────────────────────────────────
GROQ_API_KEY=
PRIMARY_MODEL=llama-3.3-70b-versatile
FALLBACK_MODEL=llama3-8b-8192

# ─── Email (SMTP untuk OTP) ───────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=lapor.ai.noreply@gmail.com
SMTP_PASSWORD=
SMTP_FROM_NAME=LAPOR-AI Sistem Pengaduan
